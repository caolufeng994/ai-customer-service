# ============================================================
# AI 智能客服系统 - 环境变量模板 (.env.example)
# 本文件必须提交到仓库（说明所有必需变量），但不得包含任何真实密钥
# 真实配置请复制为 .env：cp .env.example .env  （.env 已被 .gitignore 排除）
# ============================================================

# ---------- 数据库 (MySQL 8.0) ----------
# 应用启动时不会自动建表，需先执行 backend/init_db.sql 建库建表
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_customer_service
DB_USER=root
DB_PASSWORD=your_password_here

# ---------- JWT 认证 ----------
# 请务必改为随机长字符串：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---------- LLM (阿里云百炼 / DashScope) ----------
# 默认走 DashScope 云端大模型（已移除本地 Ollama 兜底）
LLM_PROVIDER=dashscope
# 阿里云百炼控制台创建的 API Key，同时供 LLM 与 Embedding 使用（仅一个 Key）
DASHSCOPE_API_KEY=your-dashscope-api-key
# DashScope 对话模型（较新推荐，按能力/成本选择其一）：
#   qwen3.7-max   最新的最强旗舰，质量最佳、成本最高
#   qwen3.7-plus  均衡之选（默认），质量与成本平衡
#   qwen3.7-flash 速度最快、成本最低，适合高并发
DASHSCOPE_MODEL=qwen3.7-plus

# ---------- Embedding (与 LLM 共用同一个 DASHSCOPE_API_KEY) ----------
# 默认 dashscope；可选 local（离线，但会拉取 sentence-transformers 大模型，较重）
EMBEDDING_PROVIDER=dashscope
# 最新嵌入模型（2026 发布，1024 维，与 Chroma 维度兼容）
EMBEDDING_MODEL=qwen3.7-text-embedding
# 本地嵌入模型（仅 EMBEDDING_PROVIDER=local 时生效）
LOCAL_EMBEDDING_MODEL=bge-small-zh-v1.5

# ---------- 向量数据库 (Chroma, 本地文件型, 首次运行自动创建, 无需账号) ----------
CHROMA_PERSIST_DIR=./data/chroma

# ---------- 知识库初始化 ----------
# true  = 服务启动时自动把 seed_docs 向量化（幂等，已入库的会跳过），实现"启动即可测问答"
# false = 默认，改用手动命令：cd backend && python init_kb.py
AUTO_INIT_KB=false

# ---------- 应用 ----------
APP_NAME=AI Customer Service
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# ---------- CORS (前端 vite dev 端口) ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- 业务规则 (默认值即可, 一般无需修改) ----------
DAILY_QUOTA_LIMIT=100
MAX_QUESTION_LENGTH=500
RETRIEVAL_TOP_K=8
RETRIEVAL_THRESHOLD=0.35
MAX_HISTORY_ROUNDS=3
